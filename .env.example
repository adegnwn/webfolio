# Copy to .env and fill in. Fase 0 only needs the database lines; the rest arrive in Fase 1-2.

# Database (Supabase > Project Settings > Database > Connection string)
# Pooled connection, used by the app at runtime (port 6543, add ?pgbouncer=true)
DATABASE_URL=
# Direct connection, used by `prisma migrate` and the seed script (port 5432)
DIRECT_URL=

# Auth (Clerk) - Fase 1
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Storage (Cloudflare R2) - Fase 1
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=

# Render (Remotion Lambda) - Fase 1
REMOTION_AWS_ACCESS_KEY=
REMOTION_AWS_SECRET_KEY=
AWS_REGION=ap-southeast-1

# Queue (Upstash Redis) - Fase 1
UPSTASH_REDIS_URL=

# Payment - Fase 2
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
STRIPE_SECRET_KEY=
